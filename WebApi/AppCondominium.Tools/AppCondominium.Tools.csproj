<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ScoInfrastructureProject>$(MSBuildThisFileDirectory)..\..\..\SCO\src\ControleOcorrencias.Infrastructure\ControleOcorrencias.Infrastructure.csproj</ScoInfrastructureProject>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(ScoInfrastructureProject)')">
    <DefineConstants>$(DefineConstants);HAS_SCO_REFERENCE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppCondominium.Infrastructure\AppCondominium.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(ScoInfrastructureProject)')">
    <ProjectReference Include="$(ScoInfrastructureProject)" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(ScoInfrastructureProject)')">
    <Compile Remove="SmtpConfigScoTransfer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

</Project>
